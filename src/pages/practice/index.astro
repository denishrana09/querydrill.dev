---
import Base from '../../layouts/Base.astro';
---
<Base
  title="Practice MongoDB queries — 38 auto-graded exercises, in your browser"
  description="Write real MongoDB queries against a seeded dataset and get field-level feedback on exactly what your result got wrong. No signup, no install, no database."
>
  <header class="topbar">
    <div class="brand">mongo<span>practice</span></div>

    <button id="resetDataBtn" class="ghost" title="Restore the dataset to its original state">
      Reset data
    </button>

    <div class="spacer"></div>

    <div class="soon" title="Available in the local npx mode, coming soon">
      Coming soon: connect your own MongoDB · <code>explain()</code> · indexes
    </div>

    <div id="status" class="status ok"><i></i><span>runs in your browser</span></div>
  </header>

  <main class="layout">
    <aside class="pane sidebar">
      <h2>Collections</h2>
      <ul id="collections" class="collections"></ul>
      <h2>Sample document</h2>
      <pre id="sampleDoc" class="sample muted">click a collection</pre>
    </aside>

    <section class="pane editor-pane">
      <div class="toolbar">
        <button id="runBtn" class="primary">Run <kbd>Ctrl</kbd>+<kbd>Enter</kbd></button>
        <div class="spacer"></div>
        <span id="editorLabel" class="editor-label">free play</span>
        <button id="resetBtn" class="ghost" title="Restore the starter code">reset</button>
      </div>

      <textarea id="editor" spellcheck="false" autocomplete="off"
        placeholder="db.orders.find({ status: &quot;completed&quot; }).limit(5)"></textarea>

      <div class="results">
        <div id="resultMeta" class="result-meta muted">results appear here</div>
        <pre id="resultBody" class="result-body"></pre>
      </div>
    </section>

    <aside class="pane exercises-pane">
      <div class="ex-head">
        <h2>Exercises</h2>
        <span id="progress" class="progress"></span>
      </div>
      <div id="exerciseList" class="ex-list"></div>
    </aside>
  </main>

  <div id="toast" class="toast"></div>

  <script>
    import '../../scripts/app.js';
  </script>

  <style>
    .soon {
      font-size: 11px;
      opacity: 0.55;
      margin-right: 14px;
      white-space: nowrap;
    }
    .soon code { font-size: 11px; }
    @media (max-width: 1100px) { .soon { display: none; } }
  </style>
</Base>
