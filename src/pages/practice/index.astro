---
import Base from '../../layouts/Base.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
---
<Base
  bodyClass="app"
  title="Practice MongoDB queries — 38 auto-graded exercises, in your browser"
  description="Write real MongoDB queries against a seeded dataset and get field-level feedback on exactly what your result got wrong. No signup, no install, no database."
>
  <header class="topbar">
    <div class="brand">mongo<span>practice</span></div>
    <div class="spacer"></div>
    <div class="soon" title="Available in the local npx mode, coming soon">
      Coming soon: connect your own MongoDB · <code>explain()</code> · indexes
    </div>
    <div id="status" class="status ok"><i></i><span>runs in your browser</span></div>
    <ThemeToggle />
  </header>

  <main class="layout">
    <aside id="paneData" class="pane sidebar">
      <h2>Collections</h2>
      <ul id="collections" class="collections"></ul>

      <div class="pane-head">
        <h2 id="schemaTitle">Fields</h2>
        <button id="rawToggle" class="linkish" type="button">raw doc</button>
      </div>
      <div id="schema" class="schema"><p class="muted">pick a collection</p></div>
      <pre id="sampleDoc" class="sample" hidden></pre>
    </aside>

    <section id="paneEditor" class="pane editor-pane">
      <div class="toolbar">
        <button id="runBtn" class="primary">Run <kbd>Ctrl</kbd>+<kbd>Enter</kbd></button>
        <button id="formatBtn" class="ghost" title="Tidy the query — Shift+Alt+F">Format</button>
        <button id="copyQueryBtn" class="ghost" title="Copy the query">Copy</button>

        <!-- Only appears once a query has actually written to the data, so it
             explains itself instead of sitting there as a permanent puzzle. -->
        <span id="dirtyBar" class="dirty" hidden>
          data modified
          <button id="resetDataBtn" type="button">restore</button>
        </span>

        <div class="spacer"></div>
        <span id="editorLabel" class="editor-label">free play</span>
        <button id="resetBtn" class="ghost" title="Restore the starter code">reset</button>
      </div>

      <textarea id="editor" spellcheck="false" autocomplete="off"
        placeholder="db.orders.find({ status: &quot;completed&quot; }).limit(5)"></textarea>

      <div id="splitter" class="splitter" role="separator" aria-orientation="horizontal"
        tabindex="0" title="Drag to resize"></div>

      <div class="results">
        <div class="results-head">
          <div id="resultMeta" class="result-meta muted">results appear here</div>
          <button id="copyResultBtn" class="ghost tiny" hidden title="Copy the results">Copy</button>
        </div>
        <pre id="resultBody" class="result-body json-view"></pre>
      </div>
    </section>

    <aside id="paneExercises" class="pane exercises-pane">
      <div class="ex-head">
        <h2>Exercises</h2>
        <span id="progress" class="progress"></span>
      </div>
      <div id="exerciseList" class="ex-list"></div>
      <!--
        The reading pages carry this in their footer, but this page is a fixed
        shell with no footer - so it was the one page of 74 without it, and the
        one people spend the longest on and are most likely to screenshot. It
        sits inside the scrolling list rather than below it, so it costs the
        layout no height.
      -->
      <p class="app-fine">
        Not affiliated with MongoDB, Inc. MongoDB is a trademark of MongoDB, Inc.
      </p>
    </aside>
  </main>

  <!--
    Only visible once there is no room for three columns. Buttons with
    aria-pressed rather than a tablist: on a wide screen all three panes are
    shown at once and none of them is a tab.

    It floats, and it is loud on purpose. The first version sat flush at the
    bottom in `--panel`, which is 1.08:1 against the page - a real surface in the
    token set, and invisible as one. Grey 12px labels on top of that read as a
    footer, and people did not find it.
  -->
  <nav id="tabbar" class="tabbar" aria-label="Panes">
    <button type="button" data-pane="paneData" aria-pressed="false">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <ellipse cx="8" cy="3.6" rx="5.4" ry="2.1" />
        <path d="M2.6 3.6v8.8c0 1.16 2.42 2.1 5.4 2.1s5.4-.94 5.4-2.1V3.6" />
        <path d="M2.6 8c0 1.16 2.42 2.1 5.4 2.1s5.4-.94 5.4-2.1" />
      </svg>
      <span class="tab-label">Data</span>
    </button>
    <button type="button" data-pane="paneEditor" aria-pressed="true">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5.6 4.2 2 8l3.6 3.8" />
        <path d="M10.4 4.2 14 8l-3.6 3.8" />
      </svg>
      <span class="tab-label">Editor</span>
    </button>
    <button type="button" data-pane="paneExercises" aria-pressed="false">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2 4.6 3.4 6 6 3.2" />
        <path d="M2 11.4 3.4 12.8 6 10" />
        <path d="M8.6 4.6H14" />
        <path d="M8.6 11.4H14" />
      </svg>
      <span class="tab-label">Exercises</span>
      <span id="tabCount" class="tab-count"></span>
    </button>
  </nav>

  <div id="toast" class="toast"></div>

  <script>
    import '../../scripts/app.js';
  </script>
</Base>
