---
import Base from '../layouts/Base.astro';

// Placeholder home page. Its only job right now is to prove the architecture:
// the query engine, the dataset and the exercises all have to bundle and run
// client-side with no server. The real UI lands in the next step.
import { EXERCISES } from '../../server/exercises/index.js';

const exerciseCount = EXERCISES.length;
---
<Base
  title="MongoDB Practice — run and grade MongoDB queries in your browser"
  description="Practice MongoDB with hand-written, auto-graded exercises. No signup, no install, no database — queries run entirely in your browser."
>
  <main class="smoke">
    <h1>Architecture smoke test</h1>
    <p>
      {exerciseCount} exercises loaded at build time. The query below runs entirely
      in this tab — no server, no MongoDB.
    </p>

    <pre id="query"></pre>
    <pre id="out">running…</pre>
  </main>

  <script>
    import { makeMingoDb } from '../../engine/mingo-db.js';
    import { runCode } from '../../engine/run.js';
    import ecommerce from '../../server/datasets/ecommerce.js';

    const CODE = `db.orders.aggregate([
  { $match: { status: "completed" } },
  { $unwind: "$items" },
  { $group: { _id: "$items.category", revenue: { $sum: { $multiply: ["$items.price", "$items.quantity"] } } } },
  { $sort: { revenue: -1 } }
])`;

    const store = ecommerce.build();
    const db = makeMingoDb(store);

    document.getElementById('query').textContent = CODE;

    const result = await runCode(db, CODE);
    document.getElementById('out').textContent = result.ok
      ? `ok in ${result.ms}ms\n\n` + JSON.stringify(result.value, null, 2)
      : `error: ${result.error}`;
  </script>

  <style>
    .smoke { max-width: 70ch; margin: 3rem auto; padding: 0 1.5rem; font: 14px/1.6 ui-monospace, monospace; }
    h1 { font-size: 1.2rem; }
    pre { background: #11151c; color: #d6deeb; padding: 1rem; border-radius: 6px; overflow-x: auto; }
  </style>
</Base>
