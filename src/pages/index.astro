---
import Base from '../layouts/Base.astro';
import { EXERCISES } from '../../server/exercises/index.js';

// Placeholder. The real landing page (positioning, live editor above the fold,
// module list) is section 5 of ROADMAP.md.
const count = EXERCISES.length;
---
<Base
  title="MongoDB Practice — run and grade MongoDB queries in your browser"
  description="Practice MongoDB with hand-written, auto-graded exercises that tell you exactly which field of your result is wrong. No signup, no install, no database."
>
  <main class="hero">
    <h1>Practice MongoDB in your browser</h1>
    <p>
      {count} hand-written exercises, graded against a live reference solution.
      When you get one wrong it tells you <em>which field</em> was wrong — not just
      that you were.
    </p>
    <p class="sub">No signup. No install. No database. Queries run in this tab.</p>
    <a class="cta" href="/practice/">Start practising →</a>
  </main>

  <style>
    .hero {
      max-width: 46rem;
      margin: 12vh auto;
      padding: 0 1.5rem;
      font-family: system-ui, sans-serif;
      color: #d6deeb;
    }
    h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 0 0 1rem; }
    p { font-size: 1.05rem; line-height: 1.6; color: #a8b6c9; }
    .sub { font-size: 0.95rem; color: #7d8ba0; }
    .cta {
      display: inline-block;
      margin-top: 1.5rem;
      padding: 0.7rem 1.3rem;
      background: #10b981;
      color: #08131a;
      font-weight: 600;
      border-radius: 6px;
      text-decoration: none;
    }
  </style>
</Base>
