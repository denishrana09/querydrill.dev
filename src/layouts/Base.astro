---
import '../styles/global.css';

/**
 * Every page goes through here so the SEO tags can never be forgotten on one.
 * Per-lesson titles and descriptions are the whole ranking strategy - see the
 * SEO section of ROADMAP.md - so `title` and `description` are required.
 */
const {
  title,
  description,
  noindex = false,
  jsonLd = null,
  // "app" is the fixed three-pane practice shell; "doc" is a scrolling page.
  bodyClass = 'doc',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Rendered from design/og.html by design/render.mjs. test/links.mjs fails the
// build if the file is missing, which is what went unnoticed for weeks before.
const ogImage = new URL('/og.png', Astro.site).href;
const ogImageAlt = 'QueryDrill: learn MongoDB by running queries. A query with graded feedback explaining why its result is wrong.';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="QueryDrill" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <script is:inline>
    // Blocking, and deliberately before the stylesheet does anything: a theme
    // applied after first paint is a white flash on every single navigation,
    // which is more annoying than having no toggle at all. `is:inline` keeps
    // Astro from bundling and deferring it.
    (function () {
      var saved = null;
      try { saved = localStorage.getItem('mp.theme'); } catch (e) { /* private mode */ }
      document.documentElement.dataset.theme =
        saved === 'light' || saved === 'dark'
          ? saved
          : window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    })();
  </script>

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <slot name="head" />
</head>
<body class={bodyClass}>
  <slot />

  <script is:inline>
    // Wiring for any [data-theme-toggle] button, delegated from the document so
    // it does not care whether the button is in the static header or drawn by
    // the app. Inline for the same reason as above: no bundle on pages that
    // otherwise ship zero JavaScript.
    (function () {
      var KEY = 'mp.theme';
      var root = document.documentElement;

      function label() {
        var dark = root.dataset.theme === 'dark';
        var text = dark ? 'Switch to light theme' : 'Switch to dark theme';
        document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
          b.setAttribute('aria-label', text);
          b.setAttribute('title', text);
          b.setAttribute('aria-pressed', String(!dark));
        });
      }

      document.addEventListener('click', function (e) {
        if (!e.target.closest || !e.target.closest('[data-theme-toggle]')) return;
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        // Only a real click writes to storage. Until then the OS setting is
        // followed live, which is what someone who never touched the button
        // expects when they flip their system into dark mode at night.
        try { localStorage.setItem(KEY, root.dataset.theme); } catch (err) { /* private mode */ }
        label();
      });

      window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', function (e) {
        var saved = null;
        try { saved = localStorage.getItem(KEY); } catch (err) { /* private mode */ }
        if (saved) return;
        root.dataset.theme = e.matches ? 'light' : 'dark';
        label();
      });

      label();
    })();
  </script>
</body>
</html>
