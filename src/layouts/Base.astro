---
import '../styles/global.css';

/**
 * Every page goes through here so the SEO tags can never be forgotten on one.
 * Per-lesson titles and descriptions are the whole ranking strategy - see the
 * SEO section of ROADMAP.md - so `title` and `description` are required.
 */
const {
  title,
  description,
  noindex = false,
  jsonLd = null,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-default.png', Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
