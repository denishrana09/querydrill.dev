---
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/doc.css';

/**
 * Shell for every reading page: lessons, module hubs, reference, the dataset.
 * Anything that is a document rather than the app goes through here, so the
 * header, footer and prose measure are decided once.
 */
const { title, description, jsonLd = null, nav = null, wide = false } = Astro.props;
---
<Base title={title} description={description} jsonLd={jsonLd} bodyClass="doc">
  <SiteHeader current={nav} />
  <main class={wide ? 'doc-main wide' : 'doc-main'}>
    <slot />
  </main>
  <footer class="site-foot">
    <p>
      Queries run in your browser. Nothing is uploaded, and there is no account to make.
    </p>
    <p class="fine">
      Not affiliated with MongoDB, Inc. MongoDB is a trademark of MongoDB, Inc.
    </p>
  </footer>
</Base>
